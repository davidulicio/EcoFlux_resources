[Unit]
Description=Carbonique Hub
After=network.target
[Service]
User=carbonique
Group=carbonique
WorkingDirectory=/srv/carbonique-hub
EnvironmentFile=/srv/carbonique-hub/.env
ExecStart=/srv/carbonique-hub/.venv/bin/gunicorn carbonique.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 120
Restart=on-failure
[Install]
WantedBy=multi-user.target
